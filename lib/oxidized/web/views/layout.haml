!!! 5
%html{lang: 'en'}
  !=haml :head
  %body
    - current_path = request.path_info
    .app-shell
      %aside.app-sidebar#app-sidebar{:'aria-label' => 'Primary navigation'}
        .sidebar-brand
          %a.brand-link{href: url_for('/nodes'), :'aria-label' => 'Oxidized home'}
            %img{src: url_for('/images/oxidizing_40px.png'), alt: '', width: 32, height: 32}
            %span.brand-copy
              %strong Oxidized
              %small Configuration manager
        .sidebar-section-label Workspace
        %nav.sidebar-nav
          %a.sidebar-link{href: url_for('/nodes'),
                          class: current_path == '/nodes' || current_path.start_with?('/nodes/group/', '/nodes/model/') ? 'active' : '',
                          :'aria-current' => current_path == '/nodes' || current_path.start_with?('/nodes/group/', '/nodes/model/') ? 'page' : nil}
            %i.bi.bi-hdd-network{:'aria-hidden' => 'true'}
            %span Device inventory
          %a.sidebar-link{href: url_for('/nodes/stats'),
                          class: current_path == '/nodes/stats' ? 'active' : '',
                          :'aria-current' => current_path == '/nodes/stats' ? 'page' : nil}
            %i.bi.bi-activity{:'aria-hidden' => 'true'}
            %span Backup health
          %a.sidebar-link{href: '#global-config-search'}
            %i.bi.bi-search{:'aria-hidden' => 'true'}
            %span Configuration search
        .sidebar-footer
          %span.status-dot{:'aria-hidden' => 'true'}
          %span Oxidized Web
          %small v.#{Oxidized::API::WEB_VERSION}

      .app-main
        %header.app-topbar
          %button.sidebar-toggle#sidebar-toggle{type: 'button',
                                                :'aria-label' => 'Open navigation',
                                                :'aria-expanded' => 'false',
                                                :'aria-controls' => 'app-sidebar'}
            %i.bi.bi-list{:'aria-hidden' => 'true'}
          .topbar-context
            %span.eyebrow Network operations
            %span.topbar-title Configuration management
          .topbar-actions
            %form.config-search{role: 'search', action: url_for('/nodes/conf_search'), method: 'post'}
              %label.visually-hidden{for: 'global-config-search'} Search in configurations
              %i.bi.bi-search{:'aria-hidden' => 'true'}
              %input#global-config-search{name: 'search_in_conf_textbox', type: 'search', placeholder: 'Search configurations…'}
            %button.theme-toggle#theme-toggle{type: 'button', :'aria-label' => 'Switch to dark theme', :'aria-pressed' => 'false'}
              %i.bi.bi-moon-stars{:'aria-hidden' => 'true'}
        %main.app-content#main-content
          .page-container
            != yield
    !=haml :footer


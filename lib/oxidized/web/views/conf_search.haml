.page-heading
  .page-heading-copy
    .breadcrumbs
      %a{href: url_for('/nodes')} Devices
      %i.bi.bi-chevron-right{:'aria-hidden' => 'true'}
      %span Configuration search
    %span.eyebrow.text-muted Search results
    %h1 Configuration matches
    %p
      Nodes whose current configuration matches
      %strong&= "#{@to_research}"
  .page-heading-actions
    %button.btn.btn-outline-secondary{type: 'button', onclick: 'window.location.reload();'}
      %i.bi.bi-arrow-clockwise{:'aria-hidden' => 'true'}
      Refresh

.table-card.search-results-card
  .table-toolbar
    %span.toolbar-label #{@nodes_match.length} matching devices
  .table-responsive
    %table.table.table-hover.align-middle#versionsTable
      %thead
        %tr
          %th Name
          %th Configuration

      %tbody
        - @nodes_match.each do |x|
          %tr
            %td.device-name= x[:node]
            %td
              %a.action-link{title: 'Download configuration', :'aria-label' => "Download configuration for #{x[:node]}",
                 href: url_for("/node/fetch/#{x[:full_name]}")}
                %i.bi.bi-cloud-download{:'aria-hidden' => 'true'}

:javascript
  $(function() {
    $('#versionsTable').dataTable({
      autoWidth: false,
      "order": [[0, "asc"]]
    });
  });

